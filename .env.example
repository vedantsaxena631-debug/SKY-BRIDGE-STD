# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------- server
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------- database
MONGODB_URI=mongodb://127.0.0.1:27017/skybridge

# ---------------------------------------------------------------- auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=2h

# Read-only, no-credentials access to Demo Mode from the login page.
# There is no guest path into Live Mode.
ALLOW_GUEST_DEMO=true

# ---------------------------------------------------------------- serial (Live Mode)
# Windows: COM3   macOS: /dev/tty.usbserial-0001   Linux: /dev/ttyUSB0
# Leave blank if no hardware is attached - Live Mode still runs and honestly
# reports an empty network.
SERIAL_PORT=
SERIAL_BAUD_RATE=115200

# How long a node may stay quiet before it is marked offline.
# Set this to a few times the firmware's heartbeat interval.
HEARTBEAT_TIMEOUT_MS=20000

# ---------------------------------------------------------------- seed accounts
# Used once by scripts/seedUsers.js. Change these before any demo.
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_A_PASSWORD=
SEED_OPERATOR_B_PASSWORD=
SEED_VIEWER_PASSWORD=
